//                                                        ▄▀▀▀▄  ▄  ▄▀▀▀▄  ▄  ▄▀▀▀▄  █  ▄▀▀▀▄
//                                                        █   █  █  █   █  █  █   █  █  █   █
//                                                         ▀▀▀   █   ▀▀▀   █   ▀▀▀   ▀   ▀▀▀
//                                                               █      ▄▄▄█▄▄▄    █   █
//                                                               ▀      █  █  █     █▄█
//                                                             ▀▀▀▀▀    █  █  █      ▀
//                                                                      ▀  ▀  ▀
//
// ▄▄▄▄▄▄▄▄▄▄▄▄▄▄▄▄▄▄▄▄▄▄▄▄▄▄▄▄▄▄▄▄▄▄▄▄▄▄▄▄▄▄▄▄▄▄▄▄▄▄▄▄▄▄▄▄▄▄▄▄▄▄▄▄▄▄▄▄▄▄▄▄▄▄▄▄▄▄▄▄▄▄▄▄▄▄▄▄▄▄▄▄▄▄▄▄▄▄▄▄▄▄▄▄▄▄▄▄▄▄▄▄▄▄▄▄▄▄▄▄▄▄▄▄▄▄▄▄▄▄▄▄▄▄▄▄▄▄▄▄▄▄▄▄▄▄▄▄▄

#include <behaviors.dtsi>
#include <dt-bindings/zmk/bt.h>
#include <dt-bindings/zmk/keys.h>

// Layer indices
#define BASE   0
#define NAV    1
#define NUM    2
#define SYM    3
#define FUN    4
#define DEVICE 5

// Timing parameters
#define QUICK_TAP_MS 175
#define TAPPING_TERM 280
#define REQUIRE_IDLE_MS 150

// Key position groups for homerow mods
#define KEYS_L 0 1 2 3 4 10 11 12 13 14 20 21 22 23 24 25
#define KEYS_R 5 6 7 8 9 15 16 17 18 19 26 27 28 29 30 31
#define THUMBS 32 33 34 35 36 37

&mt {
    flavor          = "tap-preferred";
    quick-tap-ms    = <QUICK_TAP_MS>;
    tapping-term-ms = <TAPPING_TERM>;
};

/ {
    behaviors {
        hml: homerow_mod_left {
            compatible = "zmk,behavior-hold-tap";
            #binding-cells = <2>;
            flavor = "balanced";
            tapping-term-ms = <TAPPING_TERM>;
            quick-tap-ms = <QUICK_TAP_MS>;
            require-prior-idle-ms = <REQUIRE_IDLE_MS>;
            bindings = <&kp>, <&kp>;
            hold-trigger-key-positions = <KEYS_R THUMBS>;
            hold-trigger-on-release;
        };

        hmr: homerow_mod_right {
            compatible = "zmk,behavior-hold-tap";
            #binding-cells = <2>;
            flavor = "balanced";
            tapping-term-ms = <TAPPING_TERM>;
            quick-tap-ms = <QUICK_TAP_MS>;
            require-prior-idle-ms = <REQUIRE_IDLE_MS>;
            bindings = <&kp>, <&kp>;
            hold-trigger-key-positions = <KEYS_L THUMBS>;
            hold-trigger-on-release;
        };

        // Layer-tap tuned for SPACE: only resolves to hold after a brief
        // typing pause, so fast space->letter rolls never fire the layer
        lts: layer_tap_space {
            compatible = "zmk,behavior-hold-tap";
            #binding-cells = <2>;
            flavor = "balanced";
            tapping-term-ms = <TAPPING_TERM>;
            quick-tap-ms = <QUICK_TAP_MS>;
            require-prior-idle-ms = <REQUIRE_IDLE_MS>;
            bindings = <&mo>, <&kp>;
        };
    };

    combos {
        compatible = "zmk,combos";

        combo_esc {
            timeout-ms = <50>;
            key-positions = <0 1>;
            bindings = <&kp ESC>;
            layers = <BASE>;
        };

        combo_caps_word {
            timeout-ms = <50>;
            key-positions = <13 16>;
            bindings = <&caps_word>;
            layers = <BASE>;
        };

        combo_copy {
            timeout-ms = <50>;
            key-positions = <22 23>;
            bindings = <&kp LG(C)>;
            layers = <BASE>;
        };

        combo_cut {
            timeout-ms = <50>;
            key-positions = <21 22>;
            bindings = <&kp LG(X)>;
            layers = <BASE>;
        };

        combo_paste {
            timeout-ms = <50>;
            key-positions = <23 24>;
            bindings = <&kp LG(V)>;
            layers = <BASE>;
        };

        combo_bspc {
            timeout-ms = <50>;
            key-positions = <8 9>;
            bindings = <&kp BSPC>;
            layers = <BASE>;
        };
    };

    conditional_layers {
        compatible = "zmk,conditional-layers";

        device {
            if-layers = <NAV SYM>;
            then-layer = <DEVICE>;
        };
    };

    keymap {
        compatible = "zmk,keymap";

        // -------------------------------------------------------------------------
        // BASE — QWERTY + Homerow Mods
        //
        // Thumb cluster:
        //   L1  ESC / NAV      L2  BSPC / NUM      L3  ENTER / LGUI
        //   R1  SPACE / SYM    R2  TAB / FUN       R3  DEL
        //   · Every layer is one thumb-hold from base (NUM on L2, SYM on space)
        //   · NAV + SYM still tri-layers to DEVICE
        // -------------------------------------------------------------------------
        base {
            bindings = <
         &kp Q       &kp W       &kp E        &kp R        &kp T          &kp Y      &kp U        &kp I        &kp O       &kp P
         &hml LGUI A &hml LALT S &hml LCTRL D &hml LSHFT F &kp G          &kp H      &hmr RSHFT J &hmr RCTRL K &hmr RALT L &hmr RGUI SEMI
&kp LCTRL  &kp Z       &kp X       &kp C        &kp V        &kp B          &kp N      &kp M        &kp COMMA    &kp DOT     &kp FSLH       &kp APOS
                                  &lt NAV ESC  &lt NUM BSPC  &mt LGUI ENTER      &lts SYM SPACE  &lt NAV TAB  &lt NUM DEL
            >;
        };

        // -------------------------------------------------------------------------
        // NAV — Window Manager (yabai/skhd) + App Tab Navigation
        //
        // Design principles:
        //   · cmd+1..0 top row    — tabs/panes in apps (browser, terminal, editor)
        //   · alt+1..5 home left  — focus spaces 1-5
        //   · alt+6..0 bot left   — focus spaces 6-10
        //   · Same finger = same number across all three rows
        //   · alt+hjkl home right — focus window, alt+m — recent space
        //   · alt+p/n bot right   — prev/next space, f fullscreen, t float, d zoom
        //   · Bot-left-outer LSHFT is the "move window" modifier: hold it to shift
        //     any alt binding — swap window (hjkl), send to space (1..0), send to
        //     prev/next space (p/n), native fullscreen (f)
        //   · Window resize (ctrl+alt+hjkl) lives on the DEVICE layer
        // -------------------------------------------------------------------------
        nav {
            bindings = <
         &kp LG(N1) &kp LG(N2) &kp LG(N3) &kp LG(N4) &kp LG(N5)      &kp LG(N6) &kp LG(N7) &kp LG(N8) &kp LG(N9) &kp LA(P)
         &kp LA(N1) &kp LA(N2) &kp LA(N3) &kp LA(N4) &kp LA(N5)      &kp LA(H)  &kp LA(J)  &kp LA(K)  &kp LA(L)  &kp LA(M)
&kp LSHFT &kp LA(N6) &kp LA(N7) &kp LA(N8) &kp LA(N9) &kp LA(N0)     &kp LA(N)  &kp LA(P)  &kp LA(F)  &kp LA(T)  &kp LA(D) &kp LA(LS(E))
                                &trans     &trans     &trans          &mo NUM    &mo SYM    &trans
            >;
        };

        // -------------------------------------------------------------------------
        // NUM — Numbers + Shifted Symbols + Glove80-style Symbol Row
        //
        // Design principles:
        //   · Digits 1-0 on top row, same column as base letters
        //   · Shifted symbols on home row, each under its digit (! @ # $ % ^ & * ( ))
        //   · Bottom row Glove80-style: brackets open left / close right,
        //     ` < > complete the pairs, - _ and + = on the right outer keys
        //   · Arrows moved to left outer/home inner so home row stays symbols
        //
        //  1   2   3   4   5        6   7   8   9   0
        //  !   @   #   $   %        ^   &   *   (   )
        // ←  HOME [   ]   →         -   +   =   PG_UP  PG_DN
        // -------------------------------------------------------------------------
        num {
            bindings = <
         &kp N1    &kp N2    &kp N3     &kp N4     &kp N5         &kp N6     &kp N7       &kp N8       &kp N9      &kp N0
         &kp EXCL  &kp AT    &kp HASH   &kp DLLR   &kp PRCNT      &kp CARET  &kp AMPS     &kp STAR     &kp LPAR    &kp RPAR
&kp HOME &kp LEFT  &kp UP &kp DOWN  &kp RIGHT  &kp END &kp MINUS  &kp PLUS     &kp EQUAL    &kp PG_UP   &kp PG_DN &trans
                              &trans     &trans     &trans          &trans     &trans       &trans
            >;
        };

        // -------------------------------------------------------------------------
        // SYM — Python-Optimized Symbols
        //
        // Design principles:
        //   · `():` outward roll on right hand (J→K→L) — the Python trigram
        //   · `{}` above `()` for visual/muscle-memory bracket alignment
        //   · `[]` top row right, `{}` below it
        //   · `->` outward roll right bot (M→,  i.e. index→middle)
        //   · `!=` outward roll left hand (D→S  i.e. middle→ring)
        //   · `_`  at left index home (F) — most common Python singleton
        //   · `#`  at left index-inner home (G) — inline comments
        //   · `@`  at left index top (R) — decorators
        //   · `*`  at right index-inner top (Y) — *args / **kwargs
        //   · `-`  duplicated: H home (arithmetic) + M bot (-> roll)
        //
        // ~   |   &   @   %       *   {   }   [   ]
        // ?   =   !   _   #       -   (   )   :   ;
        // `   \   +   ^   $       "   -   <   >   '
        // -------------------------------------------------------------------------
        sym {
            bindings = <
         &kp TILDE  &kp PIPE  &kp AMPS   &kp AT     &kp PRCNT      &kp STAR   &kp LBRC     &kp RBRC     &kp LBKT    &kp RBKT
         &kp QMARK  &kp EQUAL &kp EXCL   &kp UNDER  &kp HASH       &kp MINUS  &kp LPAR     &kp RPAR     &kp COLON   &kp SEMI
&trans   &kp GRAVE  &kp BSLH  &kp PLUS   &kp CARET  &kp DLLR       &kp DQT     &kp MINUS    &kp LT       &kp GT     &kp SQT    &trans
                               &trans     &mo NAV    &mo FUN        &trans     &trans       &trans
            >;
        };

        // -------------------------------------------------------------------------
        // FUN — Function Keys
        // -------------------------------------------------------------------------
        fun {
            bindings = <
         &kp F1    &kp F2    &kp F3     &kp F4     &kp F5         &kp F6     &kp F7       &kp F8       &kp F9      &kp F10
         &kp F11   &kp F12   &none      &none      &none          &kp RGUI   &kp RSHFT    &kp RCTRL    &kp RALT    &none
&trans   &none     &none     &none      &none      &none          &none      &none        &none        &none       &none         &trans
                              &trans     &trans     &trans          &trans     &trans       &trans
            >;
        };

        // -------------------------------------------------------------------------
        // DEVICE — BT, Media, Brightness (tri-layer: NAV + SYM)
        // -------------------------------------------------------------------------
        device {
            bindings = <
         &none     &none     &none      &none      &none          &bt BT_SEL 0 &bt BT_SEL 1 &bt BT_SEL 2 &bt BT_SEL 3 &bt BT_SEL 4
         &none     &kp LC(LA(H)) &kp LC(LA(J)) &kp LC(LA(K)) &kp LC(LA(L))    &none        &kp C_VOL_DN &kp C_VOL_UP &kp C_BRI_DN &kp C_BRI_UP
&trans   &none     &none     &none      &none      &none          &bt BT_CLR   &kp C_MUTE   &kp C_PP     &kp C_PREV   &kp C_NEXT    &trans
                              &trans     &trans     &trans          &trans       &trans       &trans
            >;
        };

        // Reserved layers for ZMK Studio
        extra1 { status = "reserved"; };
        extra2 { status = "reserved"; };
        extra3 { status = "reserved"; };
    };
};
